{
  "name": "@openvtc/trust-tasks-gen",
  "version": "0.1.0",
  "description": "Generate TypeScript modules for exactly the Trust Tasks an application pins in trust-tasks.lock, from the vendored registry bundles. The modules import the runtime from @openvtc/trust-tasks.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustoverip/dtgwg-trust-tasks-tf.git",
    "directory": "trust-tasks-ts-gen"
  },
  "homepage": "https://trusttasks.org/implementations",
  "bin": {
    "trust-tasks-gen-ts": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "rm -rf dist .test-build",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "equivalence": "npm run build && node scripts/equivalence.mjs"
  },
  "dependencies": {
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
