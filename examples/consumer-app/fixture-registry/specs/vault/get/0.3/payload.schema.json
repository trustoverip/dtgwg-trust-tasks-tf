{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasks.example.com/spec/vault/get/0.3",
  "title": "acme Vault Get 0.3 — payload",
  "description": "Read the value stored at `path` in acme's configuration vault.",
  "type": "object",
  "additionalProperties": false,
  "required": ["path"],
  "properties": {
    "path": {
      "type": "string",
      "pattern": "^/[a-z0-9/_-]*$",
      "description": "The value's path, e.g. `/payments/endpoint`."
    },
    "ext": { "$ref": "https://trusttasks.org/specs/_framework/0.4/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value"],
      "properties": {
        "path": { "type": "string" },
        "value": { "type": "string" }
      }
    }
  }
}
