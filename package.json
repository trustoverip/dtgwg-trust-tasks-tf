{
  "name": "trust-tasks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the Trust Tasks framework specification and registry website.",
  "scripts": {
    "build": "node scripts/build-registry.mjs",
    "validate": "node scripts/build-registry.mjs --validate-only",
    "serve": "node scripts/serve-website.mjs",
    "build-ts-bindings": "node scripts/build-ts-bindings.mjs",
    "test:infra": "node --test infra/cloudfront/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "yaml": "^2.5.1"
  }
}
