{
  "name": "trust-tasks",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for the Trust Tasks framework specification and registry website.",
  "scripts": {
    "build": "node scripts/build-registry.mjs",
    "validate": "node scripts/build-registry.mjs --validate-only",
    "check": "npm run validate && npm run check-bindings && npm run check-published-schemas && npm run check-version-edits && npm run check-spec-lifecycle && npm run check-sibling-core-ranges && npm run check-dart-packages && npm run check-release-lists && npm run check-doc-facts && npm run check-withdrawal-readiness && npm run validate-ceremonies && npm run test-ceremonies",
    "regen": "npm run build-ts-bindings && npm run build-go-bindings && npm run build-dart-bindings && cargo run -p trust-tasks-codegen && cargo fmt --all",
    "generate-framework-spec": "node scripts/generate-framework-spec.mjs",
    "check-framework-spec": "node scripts/generate-framework-spec.mjs --check-committed",
    "bump-framework-spec": "node scripts/generate-framework-spec.mjs --update",
    "new-spec": "node scripts/new-spec.mjs",
    "codemod:spec-links": "node scripts/codemod-spec-links.mjs",
    "serve": "node scripts/serve-website.mjs",
    "build-ts-bindings": "node scripts/build-ts-bindings.mjs",
    "build-go-bindings": "node scripts/build-go-bindings.mjs",
    "build-dart-bindings": "node scripts/build-dart-bindings.mjs",
    "build-bundles": "cargo run -q --release -p trust-tasks-codegen -- --bundles website/specs",
    "check-bundles": "node scripts/check-bundles.mjs",
    "test:infra": "node --test infra/cloudfront/*.test.mjs",
    "test:website": "node --test scripts/test/*.test.mjs",
    "smoke:website": "node scripts/smoke-website.mjs",
    "test:release-scripts": "node --test scripts/test-release/*.test.mjs",
    "test:checks": "node --test scripts/test-checks/*.test.mjs",
    "validate-ceremonies": "node scripts/validate-ceremonies.mjs",
    "test-ceremonies": "node scripts/validate-ceremonies.mjs --test",
    "check-dart-packages": "node scripts/check-dart-packages.mjs",
    "check-release-lists": "node scripts/check-release-lists.mjs",
    "check-doc-facts": "node scripts/check-doc-facts.mjs",
    "check-sibling-core-ranges": "node scripts/check-sibling-core-ranges.mjs",
    "check-bindings": "node scripts/check-bindings-conformance.mjs",
    "check-published-schemas": "node scripts/check-published-schemas.mjs",
    "check-version-edits": "node scripts/check-version-edits.mjs",
    "check-spec-lifecycle": "node scripts/check-spec-lifecycle.mjs",
    "fix-stale-references": "node scripts/fix-stale-references.mjs",
    "extends-candidates": "node scripts/extends-candidates.mjs",
    "withdraw-due": "node scripts/withdraw-due.mjs",
    "check-withdrawal-readiness": "node scripts/check-withdrawal-readiness.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
