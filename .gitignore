# Node tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (regenerated by scripts/build-registry.mjs)
website/assets/tasks.generated.js
website/registry.json
website/specs/
website/bindings/
website/ceremonies/
website/SPEC.md

# TypeScript bindings package build output (regenerated by `npm run build` inside trust-tasks-ts)
trust-tasks-ts/dist/
trust-tasks-ts/tsconfig.tsbuildinfo

# Rust
target/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript test build output
trust-tasks-ts/.test-build/

# Scratch dumps from `aws cloudfront get-distribution-config`. These carry the
# AWS account id, bucket name and certificate ARN — infrastructure identifiers
# that do not belong in a public repository. infra/cloudfront/associate.sh uses
# a mktemp directory precisely so none of this lands in the tree.
infra/cloudfront/dist*.json

# Agent scratch worktrees — never part of a spec change.
.claude/worktrees/

# Dart package build state, for trust-tasks-dart and every trust-tasks-dart-*
# package beside it. `pubspec.lock` is deliberately NOT committed: Dart's
# convention is that an application pins its lockfile and a library does not,
# because a library's constraints are resolved against the consuming app's.
# Every package here is a library.
#
# `pubspec_overrides.yaml` IS committed, in the packages that depend on
# `trust_tasks`: it points them at the in-tree core, the way the Rust crates use
# `path =` dependencies. `dart pub publish` leaves it out of the archive.
trust-tasks-dart*/.dart_tool/
trust-tasks-dart*/pubspec.lock
trust-tasks-dart*/build/
