# Node tooling
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (regenerated by scripts/build-registry.mjs)
website/assets/tasks.generated.js
website/registry.json
website/specs/
website/bindings/
website/SPEC.md

# TypeScript bindings package build output (regenerated by `npm run build` inside trust-tasks-ts)
trust-tasks-ts/dist/
trust-tasks-ts/tsconfig.tsbuildinfo

# Rust
target/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# TypeScript test build output
trust-tasks-ts/.test-build/

# Scratch dumps from `aws cloudfront get-distribution-config`. These carry the
# AWS account id, bucket name and certificate ARN — infrastructure identifiers
# that do not belong in a public repository. infra/cloudfront/associate.sh uses
# a mktemp directory precisely so none of this lands in the tree.
infra/cloudfront/dist*.json
