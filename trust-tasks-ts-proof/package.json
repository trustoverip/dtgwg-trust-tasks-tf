{
  "name": "@openvtc/trust-tasks-proof",
  "version": "0.2.0",
  "description": "W3C Data Integrity proof verification and signing for Trust Tasks: a ProofVerifier for @openvtc/trust-tasks, on @noble.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trustoverip/dtgwg-trust-tasks-tf.git",
    "directory": "trust-tasks-ts-proof"
  },
  "homepage": "https://trusttasks.org/implementations",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "dependencies": {
    "@noble/curves": "^2.0.0",
    "@noble/hashes": "^2.0.0",
    "@scure/base": "^2.4.0"
  },
  "peerDependencies": {
    "@openvtc/trust-tasks": "^0.29.0"
  },
  "devDependencies": {
    "@openvtc/trust-tasks": "^0.29.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
