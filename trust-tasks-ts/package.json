{
  "name": "@openvtc/trust-tasks",
  "version": "0.28.28",
  "description": "Generated TypeScript bindings for the Trust Tasks framework registry.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/_runtime/index.d.ts",
      "default": "./dist/_runtime/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist .test-build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "api-compat": "node scripts/api-compat.mjs"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/trustoverip/dtgwg-trust-tasks-tf.git",
    "directory": "trust-tasks-ts"
  }
}
