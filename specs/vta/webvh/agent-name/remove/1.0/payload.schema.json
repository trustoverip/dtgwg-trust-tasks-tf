{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/webvh/agent-name/remove/1.0",
  "title": "VTA WebVH Agent-Name Remove \u2014 payload",
  "description": "Release an agent name. The name becomes available for anyone else to take, so anything that resolved it may now reach a different DID.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "did",
    "name"
  ],
  "properties": {
    "did": {
      "type": "string",
      "minLength": 1,
      "description": "DID the name is bound to."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "The name, without the host \u2014 the full form is `<host>/@<name>`."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA WebVH Agent-Name Remove \u2014 response payload",
      "description": "Success response to vta/webvh/agent-name/remove. Type https://trusttasks.org/spec/vta/webvh/agent-name/remove/1.0#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "did",
        "name",
        "enabled"
      ],
      "properties": {
        "did": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether the name resolves after this call."
        },
        "ext": {
          "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
