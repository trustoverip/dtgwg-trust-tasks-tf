{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/pcs/tokens/accept/0.1",
  "title": "VTA PCS — Tokens — Accept — payload",
  "description": "A vetter's client hands its VTA the community's answer to a token draw; the VTA unblinds the tokens into the vetter's wallet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contextId",
    "community",
    "parameters",
    "response"
  ],
  "properties": {
    "contextId": {
      "type": "string",
      "minLength": 1,
      "description": "The context the engine belongs to. Its key is derived from this context's base."
    },
    "community": {
      "type": "string",
      "minLength": 1,
      "description": "The community's DID: the helper whose parameters the engine runs under."
    },
    "parameters": {
      "$ref": "../../../../_shared/0.4/pcs-engine.schema.json#/$defs/CommunityParameters",
      "description": "The community's published hidden-vetting parameters, copied verbatim from its join manifest."
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "tick",
        "preCredentials"
      ],
      "description": "The payload of the community's vtc/vetting/vetters/pcs-tokens/0.1 response, without its ext.",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "preCredentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
          }
        }
      }
    },
    "ext": {
      "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA PCS — Tokens — Accept — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "received",
        "vetter"
      ],
      "properties": {
        "received": {
          "type": "integer",
          "minimum": 0,
          "description": "Tokens taken into the wallet."
        },
        "vetter": {
          "$ref": "../../../../_shared/0.4/pcs-engine.schema.json#/$defs/VetterSummary"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
