{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/pcs/tokens/request/0.1",
  "title": "VTA PCS — Tokens — Request — payload",
  "description": "A vetter's client asks its VTA for one draw of the attestation-token drip: blinded serials bound to the vetter's member DID, the label and the tick.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contextId",
    "community",
    "parameters",
    "label",
    "tick",
    "count"
  ],
  "properties": {
    "contextId": {
      "type": "string",
      "minLength": 1,
      "description": "The context the engine belongs to. Its key is derived from this context's base."
    },
    "community": {
      "type": "string",
      "minLength": 1,
      "description": "The community's DID: the helper whose parameters the engine runs under."
    },
    "parameters": {
      "$ref": "../../../../_shared/0.4/pcs-engine.schema.json#/$defs/CommunityParameters",
      "description": "The community's published hidden-vetting parameters, copied verbatim from its join manifest."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The token label to draw under."
    },
    "tick": {
      "type": "integer",
      "minimum": 0,
      "description": "The tick of the label being drawn."
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "description": "How many tokens to ask for: normally the parameters' dripPerTick."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "TokenDrawRequest": {
      "title": "TokenDrawRequest",
      "description": "The payload of a vtc/vetting/vetters/pcs-tokens/0.1 request, without its ext.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "tick",
        "requests"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "requests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commitment",
              "openingProof"
            ],
            "properties": {
              "commitment": {
                "type": "string",
                "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
              },
              "openingProof": {
                "type": "string",
                "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
              }
            }
          }
        }
      }
    },
    "Response": {
      "$anchor": "response",
      "title": "VTA PCS — Tokens — Request — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/TokenDrawRequest"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
