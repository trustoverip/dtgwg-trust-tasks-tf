{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/events/create/0.1",
  "title": "VTA Events — Create — payload",
  "description": "A client creates a draft event the VTA holds for its principal under one of the principal's persona identifiers, outside any community. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contextId",
    "host",
    "title",
    "when",
    "registration",
    "roster"
  ],
  "properties": {
    "contextId": {
      "$ref": "../../_shared/0.1/events.schema.json#/$defs/VtaEventContextId"
    },
    "host": {
      "$ref": "../../_shared/0.1/events.schema.json#/$defs/VtaEventDid",
      "description": "The persona identifier to hold the event under: one the VTA holds in `contextId`."
    },
    "kind": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventKind"
    },
    "title": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventTitle"
    },
    "description": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventDescription"
    },
    "when": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/When"
    },
    "placeSummary": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/PlaceSummary"
    },
    "access": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/AccessDetails"
    },
    "registration": {
      "$ref": "../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/RegistrationSettings"
    },
    "roster": {
      "$ref": "../../_shared/0.1/events.schema.json#/$defs/VtaEventRoster"
    },
    "suggestedReminderMinutes": {
      "$ref": "../../_shared/0.1/events.schema.json#/$defs/VtaEventReminderList"
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA Events — Create — response payload",
      "description": "The success response to a vta/events/create/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vta/events/create/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "$ref": "../../_shared/0.1/events.schema.json#/$defs/VtaEvent"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
