{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/memory/list/0.1",
  "title": "VTA Memory List — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["contextId"],
  "properties": {
    "contextId": {
      "type": "string",
      "description": "The VTA context whose memory items to recall."
    },
    "ext": {
      "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA Memory List — response payload",
      "description": "Success response to vta/memory/list. Type https://trusttasks.org/spec/vta/memory/list/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "description": "Every memory item in the context.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "value"],
            "properties": {
              "key": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "ext": {
          "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
