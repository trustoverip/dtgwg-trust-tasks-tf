{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/dids/methods/list/0.1",
  "title": "VTA DIDs Methods — payload",
  "description": "Ask a VTA which DID methods it holds, lists and creates. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA DIDs Methods — response payload",
      "description": "Success response to vta/dids/methods/list. Type https://trusttasks.org/spec/vta/dids/methods/list/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "description": "One entry per DID method the VTA holds a profile for.",
          "items": {
            "$ref": "../../../_shared/0.2/did-summary.schema.json#/$defs/MethodInfo"
          }
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
