{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vta/credentials/revoke/0.1",
  "title": "VTA Credentials Revoke — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["credentialId"],
  "properties": {
    "credentialId": {
      "type": "string",
      "description": "The id of the credential to revoke (as returned by vta/credentials/issue)."
    },
    "reason": {
      "type": "string",
      "description": "Optional human-readable rationale, recorded for audit."
    },
    "ext": {
      "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext",
      "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTA Credentials Revoke — response payload",
      "description": "The success response to a vta/credentials/revoke request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vta/credentials/revoke/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["credentialId", "revokedAt"],
      "properties": {
        "credentialId": {
          "type": "string",
          "description": "The revoked credential's id."
        },
        "revokedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the revocation was recorded."
        },
        "ext": {
          "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext",
          "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
        }
      }
    }
  }
}
