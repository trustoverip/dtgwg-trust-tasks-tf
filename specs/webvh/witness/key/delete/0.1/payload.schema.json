{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/webvh/witness/key/delete/0.1",
  "title": "WebVH Witness Key Delete — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["witnessId"],
  "properties": {
    "witnessId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "The witness identity to destroy."
    },
    "ext": { "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "WebVH Witness Key Delete — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["witnessId", "deletedAt"],
      "properties": {
        "witnessId": { "type": "string", "minLength": 1 },
        "deletedAt": { "type": "string", "format": "date-time" },
        "ext": { "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
