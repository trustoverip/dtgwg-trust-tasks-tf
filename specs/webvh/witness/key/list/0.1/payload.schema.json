    "ext": { "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "WebVH Witness Key List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "items": { "$ref": "../../../../_shared/0.1/witness-key.schema.json#/$defs/WitnessKey" },
          "description": "Every witness identity the service holds, ordered by createdAt. Empty when it holds none."
