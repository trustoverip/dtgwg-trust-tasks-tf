{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/webvh/sync/batch/0.1",
  "title": "WebVH Sync Batch — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["updates"],
  "properties": {
    "updates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "../../../_shared/0.1/sync-update.schema.json#/$defs/SyncUpdate" },
      "description": "Complete slot states, each applied exactly as a webvh/sync/update/0.2 carrying it would be. A mnemonic appears at most once."
    },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "WebVH Sync Batch — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "items": { "$ref": "#/$defs/EntryResult" },
          "description": "One result per entry of `updates`, in request order."
        },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    },
    "EntryResult": {
      "title": "EntryResult",
      "type": "object",
      "additionalProperties": false,
      "required": ["mnemonic", "status"],
      "properties": {
        "mnemonic": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["applied", "unchanged", "refused"],
          "description": "`applied` and `unchanged` as in webvh/sync/update/0.2. `refused` — the entry was permanently refused; see `code`."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Present if and only if `status` is `refused`: the webvh/sync/update/0.2 error code the entry would have received on its own (e.g. `webvh/sync/update:historyRewrite`)."
        }
      }
    }
  }
}
