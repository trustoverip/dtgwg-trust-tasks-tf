{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/booking/pages/update/0.1",
  "title": "VTC Booking — Pages — Update — payload",
  "description": "The host changes their booking page: present members replace what is stored. Bookings already made stand. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageId"
  ],
  "properties": {
    "pageId": {
      "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingPageId"
    },
    "title": {
      "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/EventTitle"
    },
    "description": {
      "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/EventDescription"
    },
    "availability": {
      "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingAvailability"
    },
    "meetingTypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingMeetingType"
      },
      "description": "The meeting types offered."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Booking — Pages — Update — response payload",
      "description": "The success response to a vtc/booking/pages/update/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/booking/pages/update/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page"
      ],
      "properties": {
        "page": {
          "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingPage"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
