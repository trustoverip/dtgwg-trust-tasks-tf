{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/booking/bookings/book/0.1",
  "title": "VTC Booking — Bookings — Book — payload",
  "description": "Book a free slot: the community creates an unlisted meeting event for the host and the booker and registers the booker on it. The reply is the receipt. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pageId",
    "meetingTypeId",
    "start"
  ],
  "properties": {
    "pageId": {
      "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingPageId"
    },
    "meetingTypeId": {
      "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/BookingMeetingTypeId"
    },
    "start": {
      "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/EventInstant",
      "description": "The slot's start, as vtc/booking/slots/list answered it."
    },
    "answers": {
      "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/RegistrationAnswers"
    },
    "presentation": {
      "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/MembershipPresentation"
    },
    "linkCode": {
      "type": "string",
      "minLength": 43,
      "maxLength": 128,
      "description": "The code from the page's link, for a guest."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Booking — Bookings — Book — response payload",
      "description": "The success response to a vtc/booking/bookings/book/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/booking/bookings/book/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "booking",
        "event",
        "registration"
      ],
      "properties": {
        "booking": {
          "$ref": "../../../_shared/0.1/booking.schema.json#/$defs/Booking"
        },
        "event": {
          "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/EventRef"
        },
        "registration": {
          "$ref": "../../../../events/_shared/0.4/event.schema.json#/$defs/Registration"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
