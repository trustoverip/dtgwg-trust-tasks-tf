{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/rooms/community/members/list/0.1",
  "title": "VTC Rooms Community Members List — payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roomId"
  ],
  "properties": {
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The room's identifier: its DID."
    },
    "state": {
      "$ref": "../../../../../../vtc/_shared/0.1/community-room.schema.json#/$defs/MemberState",
      "description": "Only members in this state."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Opaque continuation token from a previous page's `nextCursor`."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Page size. The community chooses when absent (50 in the reference implementation)."
    },
    "ext": {
      "$ref": "../../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Rooms Community Members List — response payload",
      "description": "Success response to vtc/rooms/community/members/list. Type https://trusttasks.org/spec/vtc/rooms/community/members/list/0.1#response. One page of the room's members and offers.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "../../../../../../vtc/_shared/0.1/community-room.schema.json#/$defs/RoomMember"
          }
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Present when more remain; pass it as `cursor`."
        },
        "ext": {
          "$ref": "../../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
