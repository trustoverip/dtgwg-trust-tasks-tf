{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/rooms/community/unarchive/0.1",
  "title": "VTC Rooms Community Unarchive — payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roomId",
    "reason"
  ],
  "properties": {
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The room's identifier: its DID."
    },
    "reason": {
      "$ref": "../../../../../vtc/_shared/0.1/community-room.schema.json#/$defs/Reason"
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Rooms Community Unarchive — response payload",
      "description": "Success response to vtc/rooms/community/unarchive. Type https://trusttasks.org/spec/vtc/rooms/community/unarchive/0.1#response. The room as it now stands, `active`, and whether anything changed. Suspended members still being restored are counted in `room.status.restoring`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "changed"
      ],
      "properties": {
        "room": {
          "$ref": "../../../../../vtc/_shared/0.5/community-room.schema.json#/$defs/CommunityRoomV3"
        },
        "changed": {
          "type": "boolean",
          "description": "`false` when the room was already `active` with no change pending: nothing was written or audited."
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
