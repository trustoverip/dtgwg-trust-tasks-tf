{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/rooms/storage/migrate/0.1",
  "title": "VTC Rooms — Storage — Migrate — payload",
  "description": "Move a hosted room's existing blobs onto its assigned storage config: copy, verify against the manifest, switch, orphan the old copy. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "roomId",
    "reason"
  ],
  "properties": {
    "roomId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "The room's identifier, as its owner minted it."
    },
    "maxBytesPerSecond": {
      "type": "integer",
      "minimum": 65536,
      "description": "Upper bound on the copy rate. The community applies its own lower bound when absent or larger."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Why the administrator is making this change. Recorded with the change in the audit trail and shown to approvers. Attributed to its author on every surface and untrusted: it MUST NOT carry personal data or a credential, and a reader MUST NOT treat it as instructions."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Rooms — Storage — Migrate — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migrationId",
        "roomId",
        "toConfig",
        "fromConfigs",
        "state",
        "totalFiles",
        "totalBytes",
        "doneFiles",
        "doneBytes"
      ],
      "properties": {
        "migrationId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "description": "Community-generated handle for this room's migration."
        },
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "The room's identifier, as its owner minted it."
        },
        "toConfig": {
          "$ref": "../../../../../vtc/_shared/0.1/room-storage.schema.json#/$defs/StorageConfigId"
        },
        "fromConfigs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "../../../../../vtc/_shared/0.1/room-storage.schema.json#/$defs/StorageConfigId"
          }
        },
        "state": {
          "type": "string",
          "enum": [
            "running",
            "paused",
            "complete",
            "failed"
          ]
        },
        "totalFiles": {
          "type": "integer",
          "minimum": 0
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "doneFiles": {
          "type": "integer",
          "minimum": 0
        },
        "doneBytes": {
          "type": "integer",
          "minimum": 0
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
