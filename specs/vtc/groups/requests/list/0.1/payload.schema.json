{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/groups/requests/list/0.1",
  "title": "VTC Groups — Requests — List — payload",
  "description": "A group manager lists requests to join the groups they manage, pending by default. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "groupId": {
      "$ref": "../../../_shared/0.1/group.schema.json#/$defs/GroupId"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "declined",
        "withdrawn"
      ],
      "description": "Absent: `pending`."
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Groups — Requests — List — response payload",
      "description": "The success response to a vtc/groups/requests/list/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/groups/requests/list/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request"
            ],
            "properties": {
              "request": {
                "$ref": "../../../_shared/0.1/group.schema.json#/$defs/GroupJoinRequest"
              },
              "fields": {
                "$ref": "../../../../directory/_shared/0.1/directory-card.schema.json#/$defs/EntryFields",
                "description": "The requester's directory fields projected for the caller, as vtc/directory/entries/show would."
              }
            }
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
