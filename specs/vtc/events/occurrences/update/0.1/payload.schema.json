{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/occurrences/update/0.1",
  "title": "VTC Events — Occurrences — Update — payload",
  "description": "Change or cancel one occurrence of a series, kept against its original start; the other occurrences are unchanged. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurrence"
  ],
  "properties": {
    "eventId": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventId"
    },
    "occurrence": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/LocalDateTime",
      "description": "The occurrence to change, by its original start."
    },
    "start": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/LocalDateTime",
      "description": "Its new local start, in the series' zone."
    },
    "duration": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/JSCalendarDuration"
    },
    "title": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventTitle"
    },
    "description": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventDescription"
    },
    "placeSummary": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/PlaceSummary"
    },
    "access": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/AccessDetails"
    },
    "cancelled": {
      "type": "boolean",
      "description": "Cancel the occurrence (true) or restore a cancelled one (false)."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Why, for the audit record. Plain text."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Occurrences — Update — response payload",
      "description": "The success response to a vtc/events/occurrences/update/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/occurrences/update/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "occurrence"
      ],
      "properties": {
        "event": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/Event"
        },
        "occurrence": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventOccurrence"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
