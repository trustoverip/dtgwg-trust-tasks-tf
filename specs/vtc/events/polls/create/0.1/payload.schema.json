{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/polls/create/0.1",
  "title": "VTC Events — Polls — Create — payload",
  "description": "Someone who runs a calendar opens a scheduling poll: candidate times put to an audience, answered yes, if need be or no. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calendarId",
    "title",
    "slots",
    "voters"
  ],
  "properties": {
    "calendarId": {
      "$ref": "../../../_shared/0.4/event.schema.json#/$defs/CalendarId",
      "description": "The calendar the event it closes into will belong to."
    },
    "kind": {
      "$ref": "../../../_shared/0.4/event.schema.json#/$defs/EventKind",
      "description": "The kind of event it closes into. Absent means `event`."
    },
    "title": {
      "$ref": "../../../_shared/0.4/event.schema.json#/$defs/EventTitle"
    },
    "description": {
      "$ref": "../../../_shared/0.4/event.schema.json#/$defs/EventDescription"
    },
    "slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 30,
      "items": {
        "$ref": "../../_shared/0.1/poll.schema.json#/$defs/EventPollSlot"
      },
      "description": "The candidate times."
    },
    "audience": {
      "$ref": "../../../_shared/0.4/event.schema.json#/$defs/EventAudience",
      "description": "Who may answer. Absent: as an event in the calendar would be for."
    },
    "voters": {
      "$ref": "../../_shared/0.1/poll.schema.json#/$defs/EventPollVoters"
    },
    "closesAt": {
      "type": "string",
      "format": "date-time",
      "description": "When it stops taking answers."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Polls — Create — response payload",
      "description": "The success response to a vtc/events/polls/create/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/polls/create/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "poll"
      ],
      "properties": {
        "poll": {
          "$ref": "../../_shared/0.1/poll.schema.json#/$defs/EventPoll"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
