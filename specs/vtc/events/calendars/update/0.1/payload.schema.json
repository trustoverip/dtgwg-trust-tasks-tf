{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/calendars/update/0.1",
  "title": "VTC Events — Calendars — Update — payload",
  "description": "Change a calendar, or archive it. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calendarId"
  ],
  "properties": {
    "calendarId": {
      "$ref": "../../../_shared/0.1/event.schema.json#/$defs/CalendarId"
    },
    "name": {
      "$ref": "../../../_shared/0.1/event.schema.json#/$defs/EventTitle"
    },
    "description": {
      "anyOf": [
        {
          "$ref": "../../../_shared/0.1/event.schema.json#/$defs/EventDescription"
        },
        {
          "type": "null"
        }
      ],
      "description": "`null` clears it."
    },
    "color": {
      "anyOf": [
        {
          "$ref": "../../../_shared/0.1/event.schema.json#/$defs/Color"
        },
        {
          "type": "null"
        }
      ],
      "description": "`null` clears it."
    },
    "defaultRoster": {
      "$ref": "../../../_shared/0.1/event.schema.json#/$defs/RosterSetting"
    },
    "defaultReminderMinutes": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "../../../_shared/0.1/event.schema.json#/$defs/ReminderMinutes"
      },
      "description": "Replaces the defaults; an empty array clears them."
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "description": "`archived`: take no new events (VTI-EVT-014). Refused for the community's own calendar."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Calendars — Update — response payload",
      "description": "The success response to a vtc/events/calendars/update/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/calendars/update/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar"
      ],
      "properties": {
        "calendar": {
          "$ref": "../../../_shared/0.1/event.schema.json#/$defs/Calendar",
          "description": "The calendar as it now is."
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
