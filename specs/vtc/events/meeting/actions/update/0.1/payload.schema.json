{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/meeting/actions/update/0.1",
  "title": "VTC Events — Meeting — Actions — Update — payload",
  "description": "Change an action item: its assignee may set its status; the chair, the secretary or a host may change anything. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionId"
  ],
  "properties": {
    "actionId": {
      "$ref": "../../../_shared/0.1/meeting.schema.json#/$defs/MeetingActionItemId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "A new title. Plain text."
    },
    "assignee": {
      "$ref": "../../../../../directory/_shared/0.1/directory-card.schema.json#/$defs/EntryId",
      "description": "A new assignee."
    },
    "dueAt": {
      "type": "string",
      "format": "date-time",
      "description": "A new due date."
    },
    "status": {
      "$ref": "../../../_shared/0.1/meeting.schema.json#/$defs/MeetingActionStatus",
      "description": "A new status."
    },
    "ext": {
      "$ref": "../../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Meeting — Actions — Update — response payload",
      "description": "The success response to a vtc/events/meeting/actions/update/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/meeting/actions/update/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "$ref": "../../../_shared/0.1/meeting.schema.json#/$defs/MeetingActionItem"
        },
        "ext": {
          "$ref": "../../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
