{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/classes/enrol/0.1",
  "title": "VTC Events — Classes — Enrol — payload",
  "description": "A member's agent obtains, by blind issuance, its class credentials for the current period: the membership's and those of its groups. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "pcsIdentity",
    "requests"
  ],
  "properties": {
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$",
      "description": "The current period."
    },
    "pcsIdentity": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventMultibase",
      "description": "The member's predicate-credential-system identity for events: derived for this purpose alone (VTI-EVT-212)."
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "items": {
        "$ref": "#/$defs/ClassRequest"
      },
      "description": "One blinded request per class."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "ClassRequest": {
      "title": "ClassRequest",
      "description": "A blinded request for one class.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classLabel",
        "request"
      ],
      "properties": {
        "classLabel": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventClassLabel"
        },
        "request": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventMultibase",
          "description": "The blinded request: a commitment and its proof."
        }
      }
    },
    "PreCredential": {
      "title": "PreCredential",
      "description": "A blind pre-credential for one class.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classLabel",
        "preCredential"
      ],
      "properties": {
        "classLabel": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventClassLabel"
        },
        "preCredential": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventMultibase",
          "description": "The blind pre-credential the member's agent unblinds."
        }
      }
    },
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Classes — Enrol — response payload",
      "description": "The success response to a vtc/events/classes/enrol/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/classes/enrol/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "preCredentials"
      ],
      "properties": {
        "period": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(-[0-9]{2})?$",
          "description": "The period the credentials are for."
        },
        "preCredentials": {
          "type": "array",
          "minItems": 1,
          "maxItems": 33,
          "items": {
            "$ref": "#/$defs/PreCredential"
          },
          "description": "One per class asked for."
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
