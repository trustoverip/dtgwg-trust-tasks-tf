{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/events/anonymous/withdraw/0.1",
  "title": "VTC Events — Anonymous — Withdraw — payload",
  "description": "Withdraw from an anonymous event by a fresh attestation carrying the registration's tag. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "attestation"
  ],
  "properties": {
    "eventId": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventId"
    },
    "occurrence": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/LocalDateTime",
      "description": "On a series registered by occurrence: the occurrence, by its original start (VTI-EVT-194)."
    },
    "attestation": {
      "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventPcsAttestation",
      "description": "The attestation to the event's identity (VTI-EVT-213), bound to this document (VTI-EVT-214)."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Events — Anonymous — Withdraw — response payload",
      "description": "The success response to a vtc/events/anonymous/withdraw/0.1 request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/vtc/events/anonymous/withdraw/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "status",
        "guests",
        "event",
        "changed"
      ],
      "properties": {
        "tag": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventMultibase",
          "description": "The registration's identifier."
        },
        "status": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/RegistrationStatus"
        },
        "guests": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Plus-ones held."
        },
        "occurrence": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/LocalDateTime"
        },
        "event": {
          "$ref": "../../../../../vtc/events/_shared/0.4/event.schema.json#/$defs/EventRef"
        },
        "changed": {
          "type": "boolean",
          "description": "False where the registration was not in play (VTI-EVT-037)."
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
