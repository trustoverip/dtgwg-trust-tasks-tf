{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/networks/repudiate/0.2",
  "title": "VTC Networks — Repudiate — payload",
  "description": "Reject a network's listing of the community. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "network"
  ],
  "properties": {
    "url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "description": "The network's API base, as the network's administrators gave it."
    },
    "network": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$",
      "maxLength": 2048,
      "description": "The network's DID. For a request naming a `url`, the community refuses if the network found there answers as another DID."
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Kept in the community's audit trail. Not sent to the network."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Networks — Repudiate — response payload",
      "description": "The membership record, in state `repudiated`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership"
      ],
      "properties": {
        "membership": {
          "$ref": "../../../_shared/0.7/network-membership.schema.json#/$defs/NetworkMembership"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
