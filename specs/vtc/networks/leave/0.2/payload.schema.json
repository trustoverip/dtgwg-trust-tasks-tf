{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/networks/leave/0.2",
  "title": "VTC Networks — Leave — payload",
  "description": "Withdraw from a network the community is a member of. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network"
  ],
  "properties": {
    "network": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$",
      "maxLength": 2048,
      "description": "The network's DID."
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Kept in the community's audit trail. Not sent to the network."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Networks — Leave — response payload",
      "description": "The membership, in state `departed`.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership"
      ],
      "properties": {
        "membership": {
          "$ref": "../../../_shared/0.7/network-membership.schema.json#/$defs/NetworkMembership"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
