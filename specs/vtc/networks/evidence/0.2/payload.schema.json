{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/networks/evidence/0.2",
  "title": "VTC Networks — Evidence — payload",
  "description": "Ask for the credentials linking a group the caller belongs to up to a network. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "groupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Only links for this group. Absent: every group the caller is an active member of."
    },
    "network": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:.+$",
      "maxLength": 2048,
      "description": "Only links to this network."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Networks — Evidence — response payload",
      "description": "The chain links the caller may present, one per group and network.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "links"
      ],
      "properties": {
        "links": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "groupId",
              "groupDid",
              "network",
              "role",
              "registration",
              "acceptance"
            ],
            "properties": {
              "groupId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "groupDid": {
                "type": "string",
                "pattern": "^did:[a-z0-9]+:.+$",
                "maxLength": 2048
              },
              "network": {
                "type": "string",
                "pattern": "^did:[a-z0-9]+:.+$",
                "maxLength": 2048
              },
              "role": {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              "registration": {
                "type": "object",
                "description": "The community's signed `vtn/groups/register` request for the group, with its proof, exactly as the network accepted it."
              },
              "acceptance": {
                "type": "object",
                "description": "The network's `groupRegistered/1` statement (VSC) accepting it, carrying the registration's digest: SHA-256 over the RFC 8785 (JCS) form of the signed request including its proof."
              }
            }
          }
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
