{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/relationships/publish/0.1",
  "title": "VTC Relationships Publish — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["vrc"],
  "properties": {
    "vrc": { "type": "object", "description": "A signed W3C Verifiable Relationship Credential (opaque here). Its issuer MUST equal the document proof signer; credentialSubject.id names the subject member; it carries its own DataIntegrityProof." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Relationships Publish — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "issuerDid", "subjectDid", "vrcSha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "description": "Id assigned to the stored relationship (a UUID)." },
        "issuerDid": { "type": "string", "minLength": 1 },
        "subjectDid": { "type": "string", "minLength": 1 },
        "vrcSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the stored VRC, for out-of-band integrity checks." },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
