{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/storage/configs/retire/0.1",
  "title": "VTC Storage — Configs — Retire — payload",
  "description": "Take a storage config with no rooms assigned out of service. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "configId",
    "reason"
  ],
  "properties": {
    "configId": {
      "$ref": "../../../../../vtc/_shared/0.1/room-storage.schema.json#/$defs/StorageConfigId"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "description": "Why the administrator is making this change. Recorded with the change in the audit trail and shown to approvers. Attributed to its author on every surface and untrusted: it MUST NOT carry personal data or a credential, and a reader MUST NOT treat it as instructions."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Storage — Configs — Retire — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configId",
        "state",
        "blobsRemaining"
      ],
      "properties": {
        "configId": {
          "$ref": "../../../../../vtc/_shared/0.1/room-storage.schema.json#/$defs/StorageConfigId"
        },
        "state": {
          "type": "string",
          "enum": [
            "draining",
            "retired"
          ]
        },
        "blobsRemaining": {
          "type": "integer",
          "minimum": 0
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
