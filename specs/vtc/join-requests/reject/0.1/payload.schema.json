{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/join-requests/reject/0.1",
  "title": "VTC Join-Requests Reject — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "The join request to reject." },
    "reason": { "type": "string", "maxLength": 1024, "description": "Operator reason, recorded and optionally surfaced to the applicant." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Join-Requests Reject — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "status"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "const": "rejected" },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
