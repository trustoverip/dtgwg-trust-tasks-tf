{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/join-requests/accept/0.1",
  "title": "VTC Join-Requests Accept — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "vmcId", "vc"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "description": "The approved join request being reciprocated." },
    "vmcId": { "type": "string", "minLength": 1, "description": "Id of the membership credential the member is acknowledging." },
    "vc": { "type": "object", "description": "The reciprocal Verifiable Credential the member issues back to the community (opaque here). The member DID is the document proof's signer." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Join-Requests Accept — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "status"],
      "properties": {
        "requestId": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "const": "accepted" },
        "reciprocalVcId": { "type": "string", "description": "Id the community assigned to the stored reciprocal credential." },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
