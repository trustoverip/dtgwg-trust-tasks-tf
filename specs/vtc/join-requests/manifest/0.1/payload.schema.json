{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/join-requests/manifest/0.1",
  "title": "VTC Join-Requests Manifest — payload",
  "type": "object",
  "additionalProperties": false,
  "properties": { "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" } },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Join-Requests Manifest — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["communityDid", "criteria"],
      "properties": {
        "communityDid": { "type": "string", "minLength": 1 },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "presentationDefinition"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "presentationDefinition": { "type": "object", "description": "The presentation-definition an applicant must satisfy for this criterion (opaque here)." }
            }
          }
        },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
