{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/invitations/issue/0.1",
  "title": "VTC Invitations Issue — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectDid"],
  "properties": {
    "subjectDid": { "type": "string", "minLength": 1, "description": "DID the invitation admits." },
    "validityDays": { "type": "integer", "minimum": 1, "description": "Credential lifetime in days. Omit for the community default." },
    "role": { "type": "string", "minLength": 1, "description": "Role granted on redemption. Must be one this community defines." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Invitations Issue — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDid", "vic"],
      "properties": {
        "subjectDid": { "type": "string", "minLength": 1, "description": "The invited DID, echoed." },
        "validUntil": { "type": ["string", "null"], "format": "date-time", "description": "Expiry, or null when the invitation does not lapse." },
        "vic": { "type": "object", "description": "The signed Invitation Credential (W3C VC). Opaque here; returned once." },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
