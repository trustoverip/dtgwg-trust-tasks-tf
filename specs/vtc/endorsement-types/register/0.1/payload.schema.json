  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Endorsement-Types Register — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["endorsementType"],
      "properties": {
        "endorsementType": { "$ref": "../../../_shared/0.1/endorsement-type.schema.json#/$defs/EndorsementType" },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
