{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/members/personhood/challenge/0.1",
  "title": "VTC Members Personhood-Challenge — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["did"],
  "properties": {
    "did": { "type": "string", "minLength": 1, "description": "The member who will assert personhood." },
    "ext": { "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Members Personhood-Challenge — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["challengeId", "expiresAt"],
      "properties": {
        "challengeId": { "type": "string", "minLength": 1, "description": "Single-use nonce (a UUID). Embed it into the assert VP's proof.challenge." },
        "expiresAt": { "type": "string", "format": "date-time", "description": "The assert handler refuses the presentation past this point." },
        "ext": { "$ref": "../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
