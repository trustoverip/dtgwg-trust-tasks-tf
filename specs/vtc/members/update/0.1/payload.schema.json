{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/members/update/0.1",
  "title": "VTC Members Update \u2014 payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "did"
  ],
  "properties": {
    "did": {
      "type": "string",
      "minLength": 1,
      "description": "The member to update."
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "description": "New role (wire form). MUST NOT be `admin` \u2014 promotion to admin is a separate, gated flow, not a metadata patch."
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256,
      "description": "Operator-facing display label for this member. Editable, unlike the DID it labels \u2014 which is the point: an operator needs a name they can read on a roster of identifiers they cannot. `null` clears it; omit to leave it unchanged."
    },
    "publishConsent": {
      "type": "boolean",
      "description": "New directory-publish consent."
    },
    "departurePreference": {
      "type": "string",
      "enum": [
        "purge",
        "tombstone",
        "historical",
        "policydefault"
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Replacement extension bag (maintainer-capped, 16 KiB in the reference implementation)."
    },
    "ext": {
      "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Members Update \u2014 response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "member"
      ],
      "properties": {
        "member": {
          "$ref": "../../../_shared/0.1/member.schema.json#/$defs/MemberResponse"
        },
        "ext": {
          "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
