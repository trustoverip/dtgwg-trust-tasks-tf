{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/members/admin-remove/0.1",
  "title": "VTC Members Admin-Remove — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["did"],
  "properties": {
    "did": { "type": "string", "minLength": 1, "description": "The member to remove." },
    "disposition": { "type": "string", "enum": ["purge", "tombstone", "historical", "policydefault"] },
    "reason": { "type": "string", "maxLength": 1024, "description": "Operator reason, recorded in the audit trail." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Members Admin-Remove — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "disposition", "removed"],
      "properties": {
        "did": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "enum": ["purge", "tombstone", "historical"] },
        "removed": { "type": "boolean" },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
