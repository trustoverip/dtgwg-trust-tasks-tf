      "description": "Whether the sweep runs."
    },
    "sweepMinutes": {
      "$ref": "../../../../_shared/0.1/vetting-auto-grant.schema.json#/$defs/SweepMinutes"
    },
    "validitySeconds": {
      "$ref": "../../../../_shared/0.1/vetting-auto-grant.schema.json#/$defs/GrantValiditySeconds"
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Vetting — Auto-Grant — Update — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoGrant"
      ],
      "properties": {
        "autoGrant": {
          "$ref": "../../../../_shared/0.1/vetting-auto-grant.schema.json#/$defs/AutoGrantStatus"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
