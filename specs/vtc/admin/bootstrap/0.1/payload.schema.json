{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/admin/bootstrap/0.1",
  "title": "VTC Admin Bootstrap — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["setupSessionToken"],
  "properties": {
    "setupSessionToken": { "type": "string", "minLength": 1, "description": "The setup-session JWT (aud=vtc-install-session) minted by install/claim/finish." },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Admin Bootstrap — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["adminDid", "eventId"],
      "properties": {
        "adminDid": { "type": "string", "pattern": "^did:key:z", "description": "The admin DID just written to the ACL." },
        "eventId": { "type": "string", "minLength": 1, "description": "event_id of the persisted CommunityInstalled audit envelope (a UUID)." },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
