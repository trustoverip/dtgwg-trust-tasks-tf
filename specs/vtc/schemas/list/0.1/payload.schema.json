{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtc/schemas/list/0.1",
  "title": "VTC Schemas — List — payload",
  "description": "Page through the community's schema registry, optionally one half of it. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "$ref": "../../../_shared/0.1/schema-registry.schema.json#/$defs/SchemaKind"
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Opaque continuation token from a previous page's `nextCursor`."
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Page size. The community chooses when absent (50 in the reference implementation)."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTC Schemas — List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "../../../_shared/0.1/schema-registry.schema.json#/$defs/SchemaSummary"
          }
        },
        "nextCursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Present when more entries remain; pass it as `cursor`."
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
