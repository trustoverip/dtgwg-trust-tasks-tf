    }
  },
  {
    "note": "A record key. The recipient computes where the profile goes; a caller choosing it could put the room's name at a key the host can read.",
    "payload": {
      "roomId": "did:webvh:example.com:rooms:northwind",
      "host": "did:webvh:example.com:community",
      "key": "profile",
      "profile": { "name": "Northwind renewal" }
    }
  },
  {
    "note": "Bare/unnamespaced ext key — SPEC §4.5.1 requires every immediate child of ext to be reverse-DNS namespaced.",
