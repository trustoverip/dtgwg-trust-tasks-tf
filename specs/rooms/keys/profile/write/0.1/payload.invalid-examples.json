      "profile": { "name": "Northwind renewal", "tags": ["deal", "deal"] }
    }
  },
  {
    "note": "An icon URL. A profile carries nothing a reader fetches: a fetched icon would tell whoever serves it which member opened which room.",
    "payload": {
      "roomId": "did:webvh:example.com:rooms:northwind",
      "host": "did:webvh:example.com:community",
