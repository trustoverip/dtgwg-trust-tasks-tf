  {
    "note": "A tag with upper-case letters and a space. Tags are short identifiers.",
    "payload": {
      "roomId": "did:webvh:example.com:rooms:northwind",
      "host": "did:webvh:example.com:community",
      "profile": { "name": "Northwind renewal", "tags": ["Big Deal"] }
