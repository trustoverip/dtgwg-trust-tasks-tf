{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/rooms/blobs/chunk/0.1",
  "title": "Rooms Blobs — Chunk — payload",
  "description": "Fetch one chunk of an open blob download. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "downloadId",
    "index"
  ],
  "properties": {
    "downloadId": {
      "$ref": "../../../_shared/0.1/blobs.schema.json#/$defs/TransferId"
    },
    "index": {
      "$ref": "../../../../vta/_shared/0.1/backup-transfer.schema.json#/$defs/ChunkIndex"
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Rooms Blobs — Chunk — response payload",
      "description": "Success response to rooms/blobs/chunk. Type https://trusttasks.org/spec/rooms/blobs/chunk/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "digestMultibase",
        "data"
      ],
      "properties": {
        "index": {
          "$ref": "../../../../vta/_shared/0.1/backup-transfer.schema.json#/$defs/ChunkIndex"
        },
        "digestMultibase": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase",
          "description": "The digest of this chunk's raw bytes, restated from the manifest. The reader checks the bytes against the manifest it verified, not against this restatement."
        },
        "data": {
          "$ref": "../../../../vta/_shared/0.1/backup-transfer.schema.json#/$defs/ChunkData"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
