{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/external/accounts/delete/0.1",
  "title": "External Accounts — Delete — payload",
  "description": "A manager deletes an archived external account: its record, wrapped keys and secrets are destroyed and its derived key path is retired for good. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "id"
  ],
  "properties": {
    "context": {
      "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountContextId"
    },
    "id": {
      "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountId"
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why, in the requester's words. Recorded in the audit row. Untrusted text: displayed, never interpreted."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "External Accounts — Delete — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deletedAt"
      ],
      "properties": {
        "id": {
          "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountId"
        },
        "deletedAt": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
