{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/external/accounts/secret/set/0.1",
  "title": "External Accounts — Secret — Set — payload",
  "description": "Set a static external account's secret, sealed to the custodian. Write-only. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "id",
    "sealedSecret"
  ],
  "properties": {
    "context": {
      "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountContextId"
    },
    "id": {
      "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountId"
    },
    "sealedSecret": {
      "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/SealedTransferBundle"
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "External Accounts — Secret — Set — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "setAt"
      ],
      "properties": {
        "fingerprint": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase"
        },
        "setAt": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
