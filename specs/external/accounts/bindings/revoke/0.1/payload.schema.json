{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/external/accounts/bindings/revoke/0.1",
  "title": "External Accounts — Bindings — Revoke — payload",
  "description": "Remove one integration's binding to an external account. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "id",
    "consumer"
  ],
  "properties": {
    "context": {
      "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountContextId"
    },
    "id": {
      "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountId"
    },
    "consumer": {
      "type": "string",
      "minLength": 7,
      "maxLength": 2048,
      "pattern": "^did:[a-z0-9]+:\\S+$"
    },
    "reason": {
      "type": "string",
      "maxLength": 500,
      "description": "Why, in the requester's words. Recorded in the audit row. Untrusted text: displayed, never interpreted."
    },
    "ext": {
      "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "External Accounts — Bindings — Revoke — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account"
      ],
      "properties": {
        "account": {
          "$ref": "../../../../../external/_shared/0.1/accounts.schema.json#/$defs/ExternalAccount"
        },
        "ext": {
          "$ref": "../../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
