{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/external/credentials/issue/0.1",
  "title": "External Credentials — Issue — payload",
  "description": "Obtain a short-lived, downscoped provider credential from an external account, sealed to the caller. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context",
    "account",
    "scope",
    "ttlSeconds"
  ],
  "properties": {
    "context": {
      "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountContextId"
    },
    "account": {
      "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/AccountId"
    },
    "scope": {
      "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/CredentialScope"
    },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 3600,
      "description": "Requested lifetime; never more than the binding's `maxTtlSeconds`."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "External Credentials — Issue — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sealedCredential",
        "expiresAt",
        "scope"
      ],
      "properties": {
        "sealedCredential": {
          "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/SealedTransferBundle"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "The provider's expiry for the credential, in the clear."
        },
        "scope": {
          "$ref": "../../../../external/_shared/0.1/accounts.schema.json#/$defs/CredentialScope",
          "description": "The scope actually granted, which equals the requested one."
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
