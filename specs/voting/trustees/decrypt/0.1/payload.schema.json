{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/voting/trustees/decrypt/0.1",
  "title": "Voting — Trustees — Decrypt — payload",
  "description": "After voting closes, a trustee publishes its partial decryption of every target, each with a proof it used its share of the election key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "community",
    "electionId",
    "trustee",
    "partials"
  ],
  "properties": {
    "community": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "The community's DID: the registrar that registered the election."
    },
    "electionId": {
      "$ref": "../../../../voting/_shared/0.1/voting.schema.json#/$defs/ElectionId"
    },
    "trustee": {
      "$ref": "../../../../voting/_shared/0.1/voting.schema.json#/$defs/TrusteeIndex"
    },
    "partials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "../../../../voting/_shared/0.1/voting.schema.json#/$defs/PartialDecryption"
      }
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Voting — Trustees — Decrypt — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election",
        "phase"
      ],
      "properties": {
        "election": {
          "$ref": "../../../../voting/_shared/0.1/voting.schema.json#/$defs/ElectionSummary"
        },
        "phase": {
          "$ref": "../../../../voting/_shared/0.1/voting.schema.json#/$defs/TrusteePhase"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
