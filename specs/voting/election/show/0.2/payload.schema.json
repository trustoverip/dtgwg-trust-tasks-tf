{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/voting/election/show/0.2",
  "title": "Voting — Election Show — payload",
  "description": "Reads one election at its ballot box: its state, manifest digest, admitted count and current head, and the manifest where the caller may read the board.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "community",
    "electionId"
  ],
  "properties": {
    "community": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "The community's DID."
    },
    "electionId": {
      "$ref": "../../../_shared/0.2/voting.schema.json#/$defs/ElectionId"
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Voting — Election Show — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election"
      ],
      "properties": {
        "election": {
          "$ref": "../../../_shared/0.2/voting.schema.json#/$defs/ElectionSummary"
        },
        "manifest": {
          "$ref": "../../../_shared/0.2/voting.schema.json#/$defs/Manifest",
          "description": "The registered manifest, exactly as registered. Present when the board is public or the caller may read the private board."
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
