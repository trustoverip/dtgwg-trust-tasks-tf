{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/voting/election/cancel/0.1",
  "title": "Voting — Election Cancel — payload",
  "description": "The community cancels one of its elections before voting closes. A cancelled election admits no cast and has no result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "community",
    "electionId",
    "reason"
  ],
  "properties": {
    "community": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "The community's DID. Equal to the proven signer."
    },
    "electionId": {
      "$ref": "../../../_shared/0.1/voting.schema.json#/$defs/ElectionId"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Why the community cancels the election, in its own words. Kept by the ballot box with the request; never written to the board."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Voting — Election Cancel — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "election"
      ],
      "properties": {
        "election": {
          "$ref": "../../../_shared/0.1/voting.schema.json#/$defs/ElectionSummary"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
