{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/voting/_shared/0.1/voting.schema.json",
  "title": "Community voting — shared definitions",
  "description": "Reusable $defs for the voting/*, vtc/elections/* and vta/pcs/voter/* task families. Not itself a Trust Task specification. The conventions these shapes serve are in CONVENTIONS.md beside this file; the normative requirements are VTI-VOT-001 – 100 of the VTI specification.",
  "$defs": {
    "Multibase": {
      "title": "Multibase",
      "description": "A binary value, multibase base58btc over the suite's canonical (compressed) encoding.",
      "type": "string",
      "maxLength": 16384,
      "pattern": "^z[1-9A-HJ-NP-Za-km-z]+$"
    },
    "ElectionId": {
      "title": "ElectionId",
      "description": "An election's identifier, unique within its community. A closed alphabet: it appears in the ticket class label `voter/<electionId>` and is framed into every hash a cast is bound to.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "Key": {
      "title": "Key",
      "description": "A question or option key, unique within its manifest or question.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "SecrecyLevel": {
      "title": "SecrecyLevel",
      "description": "`open`: ballots are recorded on the board as cast. `sealed`: ballots are encrypted to a jointly generated election key and decrypted after voting closes. `talliedEncrypted`: ballots are encrypted and only the totals are ever decrypted (VTI-VOT-060). Version 0.1 of the voting tasks carries open ballots only; a ballot box refuses to register any other level with `voting/election/register:unsupportedSecrecy` until the trustee tasks are specified.",
      "type": "string",
      "enum": [
        "open",
        "sealed",
        "talliedEncrypted"
      ]
    },
    "RollRule": {
      "title": "RollRule",
      "description": "Who may be issued a ticket (VTI-VOT-021): the community's active members, its active members and the parties `listed` names, or only the parties `listed` names.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "enum": [
            "members",
            "membersAndListed",
            "listed"
          ]
        },
        "listed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "description": "A DID enfranchised by name."
          },
          "uniqueItems": true
        }
      }
    },
    "Revote": {
      "title": "Revote",
      "description": "What a later, different ballot under one ticket does: `replace` the earlier one, or be refused (`refuse`) (VTI-VOT-041).",
      "type": "string",
      "enum": [
        "replace",
        "refuse"
      ]
    },
    "BoardVisibility": {
      "title": "BoardVisibility",
      "description": "`public`: anyone reads the board. `private`: the community, the auditors the manifest names and, for one cast's inclusion, the holder of its receipt (VTI-VOT-052).",
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "QuestionOption": {
      "title": "QuestionOption",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/Key"
        },
        "label": {
          "type": "string",
          "maxLength": 512,
          "description": "Display text. Absent from a manifest registered with a ballot box that holds no question text (VTI-VOT-014)."
        }
      }
    },
    "Question": {
      "title": "Question",
      "description": "One question. Tagged union over `type`.",
      "oneOf": [
        {
          "title": "ChoiceQuestion",
          "description": "Select between `minSelections` and `maxSelections` of `options`. A yes/no/abstain motion is a choice of exactly one of three.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "type",
            "options",
            "minSelections",
            "maxSelections",
            "optional"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/Key"
            },
            "type": {
              "const": "choice"
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/QuestionOption"
              }
            },
            "minSelections": {
              "type": "integer",
              "minimum": 0
            },
            "maxSelections": {
              "type": "integer",
              "minimum": 1
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "RankingQuestion",
          "description": "Order `options`; a ballot ranks every option or, when `partial` is true, a prefix of them.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "type",
            "options",
            "partial",
            "optional"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/Key"
            },
            "type": {
              "const": "ranking"
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 64,
              "items": {
                "$ref": "#/$defs/QuestionOption"
              }
            },
            "partial": {
              "type": "boolean"
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "ScoreQuestion",
          "description": "Give each option an integer score within [min, max].",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "type",
            "options",
            "min",
            "max",
            "optional"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/Key"
            },
            "type": {
              "const": "score"
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/QuestionOption"
              }
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "title": "TextQuestion",
          "description": "Free text of at most `maxLength` characters.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "type",
            "maxLength",
            "optional"
          ],
          "properties": {
            "key": {
              "$ref": "#/$defs/Key"
            },
            "type": {
              "const": "text"
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            },
            "maxLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4096
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "Trustees": {
      "title": "Trustees",
      "description": "The trustees of a sealed or tallied-encrypted election and the number of them decryption needs (VTI-VOT-062). Neither the community nor the ballot box may be one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dids",
        "threshold"
      ],
      "properties": {
        "dids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        },
        "threshold": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "Manifest": {
      "title": "Manifest",
      "description": "What an election asks and how it is decided (VTI-VOT-010). Its digest (`manifestDigest`) is the SHA-256 multihash of its RFC 8785 (JCS) canonicalization, and every cast is bound to it (VTI-VOT-011).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electionId",
        "community",
        "questions",
        "secrecy",
        "roll",
        "registrationOpens",
        "votingOpens",
        "votingCloses",
        "revote",
        "board",
        "ballotBox",
        "binding",
        "allowEarlyClose",
        "resultsBeforeClose",
        "textReleaseThreshold"
      ],
      "properties": {
        "electionId": {
          "$ref": "#/$defs/ElectionId"
        },
        "community": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The community's DID."
        },
        "title": {
          "type": "string",
          "maxLength": 512
        },
        "description": {
          "type": "string",
          "maxLength": 8192
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/Question"
          }
        },
        "secrecy": {
          "$ref": "#/$defs/SecrecyLevel"
        },
        "roll": {
          "$ref": "#/$defs/RollRule"
        },
        "registrationOpens": {
          "type": "string",
          "format": "date-time"
        },
        "votingOpens": {
          "type": "string",
          "format": "date-time"
        },
        "votingCloses": {
          "type": "string",
          "format": "date-time"
        },
        "revote": {
          "$ref": "#/$defs/Revote"
        },
        "board": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "visibility",
            "auditors"
          ],
          "properties": {
            "visibility": {
              "$ref": "#/$defs/BoardVisibility"
            },
            "auditors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "uniqueItems": true
            }
          }
        },
        "ballotBox": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The DID of the voting service that holds the board."
        },
        "trustees": {
          "$ref": "#/$defs/Trustees"
        },
        "binding": {
          "type": "boolean",
          "description": "Whether the community treats the result as deciding something; creating a binding election takes another administrator's consent (VTI-VOT-081)."
        },
        "allowEarlyClose": {
          "type": "boolean"
        },
        "resultsBeforeClose": {
          "type": "boolean",
          "description": "Open elections only: whether running totals may be read while voting is open (VTI-VOT-061)."
        },
        "textReleaseThreshold": {
          "type": "integer",
          "minimum": 10,
          "description": "Counted ballots required before any text answer is disclosed (VTI-VOT-065)."
        }
      }
    },
    "VotingParameters": {
      "title": "VotingParameters",
      "description": "The community's published voting parameters: the PCS suite and the voting verification key tickets are issued under (VTI-VOT-020). Distinct from its hidden-vetting helper key.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite",
        "votingKey"
      ],
      "properties": {
        "suite": {
          "type": "string",
          "const": "ps-ddh-bls12381"
        },
        "votingKey": {
          "$ref": "#/$defs/Multibase"
        }
      }
    },
    "Answer": {
      "title": "Answer",
      "description": "The answer to one question. Exactly one member besides `question` is present, matching the question's type, or `abstain` for an optional question left unanswered.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "minProperties": 2,
      "maxProperties": 2,
      "properties": {
        "question": {
          "$ref": "#/$defs/Key"
        },
        "choice": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "uniqueItems": true
        },
        "ranking": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Key"
          },
          "uniqueItems": true
        },
        "scores": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Key"
          },
          "additionalProperties": {
            "type": "integer"
          }
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "abstain": {
          "const": true
        }
      }
    },
    "Ballot": {
      "title": "Ballot",
      "description": "An open ballot: one answer per question of the manifest, in any order. The bytes a cast's proof binds are the RFC 8785 (JCS) canonicalization of this object as received.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electionId",
        "manifestDigest",
        "answers"
      ],
      "properties": {
        "electionId": {
          "$ref": "#/$defs/ElectionId"
        },
        "manifestDigest": {
          "$ref": "../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase"
        },
        "answers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/Answer"
          }
        }
      }
    },
    "Cast": {
      "title": "Cast",
      "description": "A ballot and the PCS attestation that admits it (VTI-VOT-030). `attestation` is the suite's canonical encoding of the attestation made for the election point with the ballot context bound in (CONVENTIONS §3); `tag` repeats its tag so a ballot box can refuse a duplicate before the pairing check.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ballot",
        "tag",
        "attestation"
      ],
      "properties": {
        "ballot": {
          "$ref": "#/$defs/Ballot"
        },
        "tag": {
          "$ref": "#/$defs/Multibase"
        },
        "attestation": {
          "$ref": "#/$defs/Multibase"
        }
      }
    },
    "BoardHead": {
      "title": "BoardHead",
      "description": "A board's tree head (RFC 9162 §2.1). A head is signed by being carried in a document the ballot box signs; whoever keeps a head keeps that whole document.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electionId",
        "treeSize",
        "rootHash",
        "issuedAt"
      ],
      "properties": {
        "electionId": {
          "$ref": "#/$defs/ElectionId"
        },
        "treeSize": {
          "type": "integer",
          "minimum": 0
        },
        "rootHash": {
          "$ref": "../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase",
          "description": "The RFC 9162 Merkle tree hash (SHA-256) of the first `treeSize` entries, as a multihash."
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "MerklePath": {
      "title": "MerklePath",
      "description": "An RFC 9162 audit or consistency path: the node hashes, in the order §2.1.3 / §2.1.4 define.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase"
      }
    },
    "BoardEntry": {
      "title": "BoardEntry",
      "description": "One leaf of a board. A leaf's hash is the RFC 9162 leaf hash of the JCS canonicalization of this object. Entries carry no time of arrival: the order is the board's, and a timestamp would hand anyone who reads the board the timing the registrar's log would need to pair a ticket with its cast.",
      "oneOf": [
        {
          "title": "CastEntry",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "cast"
          ],
          "properties": {
            "kind": {
              "const": "cast"
            },
            "cast": {
              "$ref": "#/$defs/Cast"
            }
          }
        },
        {
          "title": "ReplacementEntry",
          "description": "The cast at `replaces` is no longer counted: a later cast under the same tag is.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "tag",
            "replaces",
            "by"
          ],
          "properties": {
            "kind": {
              "const": "replaced"
            },
            "tag": {
              "$ref": "#/$defs/Multibase"
            },
            "replaces": {
              "type": "integer",
              "minimum": 0
            },
            "by": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "title": "LifecycleEntry",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "at"
          ],
          "properties": {
            "kind": {
              "enum": [
                "opened",
                "closed",
                "closedEarly",
                "cancelled"
              ]
            },
            "at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        {
          "title": "ResultEntry",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "result"
            },
            "result": {
              "$ref": "#/$defs/ElectionResult"
            }
          }
        }
      ]
    },
    "QuestionResult": {
      "title": "QuestionResult",
      "description": "One question's totals. `choice`: selections per option. `ranking`: per option, how many ballots placed it at each position (index 0 = first). `score`: per option, the sum and the number of ballots that scored it. `text`: the answers, in board order, withheld (`withheld: true`) below the manifest's `textReleaseThreshold`. `abstained` counts ballots that left the question unanswered.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "abstained"
      ],
      "properties": {
        "question": {
          "$ref": "#/$defs/Key"
        },
        "abstained": {
          "type": "integer",
          "minimum": 0
        },
        "choice": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Key"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "ranking": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Key"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "score": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Key"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sum",
              "count"
            ],
            "properties": {
              "sum": {
                "type": "integer"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "text": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "withheld": {
          "type": "boolean"
        }
      }
    },
    "ElectionResult": {
      "title": "ElectionResult",
      "description": "An election's result, computable by anyone who can read its board from the board and the registration alone (VTI-VOT-070).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electionId",
        "manifestDigest",
        "ballotsCounted",
        "questions",
        "head"
      ],
      "properties": {
        "electionId": {
          "$ref": "#/$defs/ElectionId"
        },
        "manifestDigest": {
          "$ref": "../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase"
        },
        "ballotsCounted": {
          "type": "integer",
          "minimum": 0
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuestionResult"
          }
        },
        "head": {
          "$ref": "#/$defs/BoardHead",
          "description": "The head of the board as it stood at close: the result counts exactly its entries."
        }
      }
    },
    "ElectionState": {
      "title": "ElectionState",
      "type": "string",
      "enum": [
        "registered",
        "registration",
        "voting",
        "closed",
        "tallied",
        "cancelled"
      ]
    },
    "ElectionSummary": {
      "title": "ElectionSummary",
      "description": "A ballot box's view of one election.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electionId",
        "community",
        "manifestDigest",
        "state",
        "ballotsAdmitted",
        "head"
      ],
      "properties": {
        "electionId": {
          "$ref": "#/$defs/ElectionId"
        },
        "community": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "manifestDigest": {
          "$ref": "../../../_framework/0.4/framework.schema.json#/$defs/DigestMultibase"
        },
        "state": {
          "$ref": "#/$defs/ElectionState"
        },
        "ballotsAdmitted": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct tags with a counted ballot."
        },
        "head": {
          "$ref": "#/$defs/BoardHead"
        }
      }
    },
    "Disclosure": {
      "title": "Disclosure",
      "description": "The statement a community publishes, and shows a member before they request a ticket, about how one election is run (VTI-VOT-090). Generated from the election's manifest and the community's configuration, never written by hand.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ballotBox",
        "ballotBoxOperator",
        "sameOperator",
        "boardVisibility",
        "auditors",
        "revote",
        "coercionResistance"
      ],
      "properties": {
        "ballotBox": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "The ballot box's DID."
        },
        "ballotBoxOperator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "Who operates the ballot box, as the community names them."
        },
        "sameOperator": {
          "type": "boolean",
          "description": "Whether the party operating the community's VTC also operates the ballot box."
        },
        "trustees": {
          "$ref": "#/$defs/Trustees"
        },
        "boardVisibility": {
          "$ref": "#/$defs/BoardVisibility"
        },
        "auditors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        },
        "revote": {
          "$ref": "#/$defs/Revote"
        },
        "coercionResistance": {
          "const": false,
          "description": "Always false: a voter can prove how they voted, so the community cannot protect a member against being made to vote a certain way."
        }
      }
    }
  }
}
