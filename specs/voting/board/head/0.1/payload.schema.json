{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/voting/board/head/0.1",
  "title": "Voting — Board Head — payload",
  "description": "Reads an election board's current tree head. The response document's proof is the head's signature.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "community",
    "electionId"
  ],
  "properties": {
    "community": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "description": "The community's DID."
    },
    "electionId": {
      "$ref": "../../../_shared/0.1/voting.schema.json#/$defs/ElectionId"
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Voting — Board Head — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head"
      ],
      "properties": {
        "head": {
          "$ref": "../../../_shared/0.1/voting.schema.json#/$defs/BoardHead"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
