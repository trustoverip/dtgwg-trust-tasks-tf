{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vault/_shared/0.1/vault-secret",
  "title": "VaultSecret — shared definition for vault secret material",
  "description": "Schema for the cleartext secret payload of a vault entry. Documents the shape both sides of a vault/release/0.1 transfer code-generate against. The secret payload is NEVER transmitted as plaintext JSON on the wire: vault/release/0.1 returns it inside an HPKE-sealed envelope (see SealedSecret in the vault/release payload schema). This shared schema is the authoritative description of the bytes inside that envelope.\n\nSensitive fields (`password`, `privateKey`, `refreshToken`, `secureNotes`, etc.) MUST be zeroised by consumers as soon as their use is complete. Consumers MUST NOT log, persist beyond cache lifetime, or transmit the cleartext outside the release-time scope.\n\nDiscriminated by `kind`, which mirrors VaultEntry.secretKind on the metadata side. The `kind` value MUST equal the metadata view's `secretKind` for the same entry.",
  "$defs": {
    "VaultSecret": {
      "title": "VaultSecret",
      "description": "Tagged union over `kind` (mirrors VaultEntry.secretKind).",
      "oneOf": [
        { "$ref": "#/$defs/PasswordSecret" },
        { "$ref": "#/$defs/PasskeySecret" },
        { "$ref": "#/$defs/OAuthTokensSecret" },
        { "$ref": "#/$defs/DidSelfIssuedSecret" },
        { "$ref": "#/$defs/DidCommPeerSecret" },
        { "$ref": "#/$defs/BearerTokenSecret" },
        { "$ref": "#/$defs/SshKeySecret" },
        { "$ref": "#/$defs/CustomSecret" }
      ]
    },
    "PasswordSecret": {
      "title": "PasswordSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "password"],
      "properties": {
        "kind": { "const": "password" },
        "username": { "type": "string" },
        "password": { "type": "string", "minLength": 1 },
        "totp": { "$ref": "#/$defs/TotpSeed" },
        "secureNotes": {
          "type": "string",
          "maxLength": 16384,
          "description": "Sensitive notes (security questions, account recovery context). Distinct from `notes` on the metadata view — `notes` is non-sensitive, this is."
        },
        "customFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/CustomField" }
        }
      }
    },
    "PasskeySecret": {
      "title": "PasskeySecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "credentialId", "privateKey", "rpId"],
      "properties": {
        "kind": { "const": "passkey" },
        "credentialId": {
          "type": "string",
          "description": "Base64url-encoded WebAuthn credential id."
        },
        "privateKey": {
          "type": "string",
          "description": "Base64url-encoded private key bytes (algorithm implied by `algorithm`)."
        },
        "algorithm": {
          "type": "string",
          "enum": ["ES256", "EdDSA", "RS256"],
          "description": "COSE algorithm identifier."
        },
        "rpId": {
          "type": "string",
          "description": "WebAuthn rpId (a domain, e.g. \"github.com\")."
        },
        "userHandle": {
          "type": "string",
          "description": "Base64url-encoded WebAuthn userHandle."
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "OAuthTokensSecret": {
      "title": "OAuthTokensSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "refreshToken"],
      "properties": {
        "kind": { "const": "oauth-tokens" },
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider identifier (\"google\", \"github\", or a maintainer-defined string for less-common providers)."
        },
        "refreshToken": { "type": "string", "minLength": 1 },
        "accessToken": { "type": "string" },
        "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
        "scopes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "DidSelfIssuedSecret": {
      "title": "DidSelfIssuedSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "did", "signingKeyId"],
      "properties": {
        "kind": { "const": "did-self-issued" },
        "did": { "type": "string", "minLength": 1 },
        "signingKeyId": {
          "type": "string",
          "minLength": 1,
          "description": "Maintainer-internal identifier for the signing key (the key itself is held by the VTA; this is a pointer)."
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "DidCommPeerSecret": {
      "title": "DidCommPeerSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "peerDid", "signingKeyId"],
      "properties": {
        "kind": { "const": "didcomm-peer" },
        "peerDid": { "type": "string", "minLength": 1 },
        "signingKeyId": { "type": "string", "minLength": 1 },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "BearerTokenSecret": {
      "title": "BearerTokenSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "token"],
      "properties": {
        "kind": { "const": "bearer-token" },
        "token": { "type": "string", "minLength": 1 },
        "headerName": {
          "type": "string",
          "default": "Authorization",
          "description": "Name of the HTTP header to carry the token in. Most APIs use \"Authorization\" with a \"Bearer \" prefix; some use \"X-Api-Key\" or similar."
        },
        "headerPrefix": {
          "type": "string",
          "default": "Bearer ",
          "description": "String to prepend to the token when forming the header value."
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "SshKeySecret": {
      "title": "SshKeySecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "privateKey"],
      "properties": {
        "kind": { "const": "ssh-key" },
        "privateKey": {
          "type": "string",
          "description": "PEM-encoded private key (OpenSSH or PKCS#8 format)."
        },
        "publicKey": { "type": "string" },
        "comment": { "type": "string" },
        "passphrase": {
          "type": "string",
          "description": "Optional passphrase if the private key is itself encrypted."
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "CustomSecret": {
      "title": "CustomSecret",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fields"],
      "properties": {
        "kind": { "const": "custom" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/CustomField" }
        },
        "secureNotes": { "type": "string", "maxLength": 16384 }
      }
    },
    "TotpSeed": {
      "title": "TotpSeed",
      "type": "object",
      "additionalProperties": false,
      "required": ["secret"],
      "properties": {
        "secret": {
          "type": "string",
          "description": "Base32 (RFC 4648) shared secret per RFC 6238."
        },
        "algorithm": {
          "type": "string",
          "enum": ["SHA1", "SHA256", "SHA512"],
          "default": "SHA1"
        },
        "digits": {
          "type": "integer",
          "enum": [6, 7, 8],
          "default": 6
        },
        "period": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300,
          "default": 30,
          "description": "Time-step in seconds."
        }
      }
    },
    "CustomField": {
      "title": "CustomField",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Field label (also exposed in metadata view as `customFieldNames`)."
        },
        "value": { "type": "string" },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "When true, consumers SHOULD render the value as masked (dotted) by default and require an explicit reveal action."
        },
        "kind": {
          "type": "string",
          "enum": ["text", "url", "email", "phone", "number", "date"],
          "default": "text",
          "description": "Hint for the consumer UI's rendering."
        }
      }
    }
  }
}
