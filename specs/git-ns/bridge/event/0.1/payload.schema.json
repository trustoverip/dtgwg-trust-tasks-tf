{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/git-ns/bridge/event/0.1",
  "title": "Git Namespaces — Bridge Event — payload",
  "description": "The bridge tells the VTC something happened on the forge — translated from the forge's webhook or found by an inspection sweep — together with any drift it now sees.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "event"
  ],
  "properties": {
    "namespace": {
      "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/NamespaceId",
      "description": "The namespace the event happened in."
    },
    "event": {
      "$ref": "#/$defs/ForgeEvent"
    },
    "drift": {
      "type": "array",
      "items": {
        "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/DriftItem"
      },
      "description": "The complete outstanding drift for each repository the event concerns, replacing what the VTC held for those repositories. Absent: the event changes no repository's drift."
    },
    "ext": {
      "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "JobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "The VTC's identifier for a job, unique across the VTC's jobs."
    },
    "ForgeRole": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "description": "A role in the forge's own vocabulary (`maintain`, `write`)."
    },
    "ForgeEvent": {
      "title": "ForgeEvent",
      "description": "One forge-neutral event, discriminated by `type`. The specification's event table says what each type means and what the VTC does with it.",
      "type": "object",
      "oneOf": [
        {
          "title": "RepoRenamed",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "from",
            "to"
          ],
          "properties": {
            "type": {
              "const": "repoRenamed"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "from": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            },
            "to": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            }
          }
        },
        {
          "title": "RepoTransferred",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "from",
            "to"
          ],
          "properties": {
            "type": {
              "const": "repoTransferred"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "from": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            },
            "to": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            }
          }
        },
        {
          "title": "RepoCreatedUnmanaged",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "resource"
          ],
          "properties": {
            "type": {
              "const": "repoCreatedUnmanaged"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "resource": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            }
          }
        },
        {
          "title": "RepoDeleted",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "resource"
          ],
          "properties": {
            "type": {
              "const": "repoDeleted"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "resource": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            }
          }
        },
        {
          "title": "RoleChanged",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "resource",
            "account"
          ],
          "properties": {
            "type": {
              "const": "roleChanged"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "resource": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            },
            "account": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeAccount"
            },
            "role": {
              "$ref": "#/$defs/ForgeRole",
              "description": "The role the account now holds. Absent: the account holds no role now."
            }
          }
        },
        {
          "title": "ProtectionChanged",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "forgeId",
            "resource",
            "requiredCheck"
          ],
          "properties": {
            "type": {
              "const": "protectionChanged"
            },
            "forgeId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId"
            },
            "resource": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/RepoResource"
            },
            "requiredCheck": {
              "type": "boolean",
              "description": "Whether the forge still refuses merges without a passing verify-trust check, with no bypass."
            }
          }
        },
        {
          "title": "InstallationRemoved",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "installationRemoved"
            }
          }
        },
        {
          "title": "AccountLinked",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "jobId",
            "account"
          ],
          "properties": {
            "type": {
              "const": "accountLinked"
            },
            "jobId": {
              "$ref": "#/$defs/JobId",
              "description": "The beginAccountLink job."
            },
            "account": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeAccount"
            }
          }
        },
        {
          "title": "BindCompleted",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "jobId",
            "ownerId",
            "kind"
          ],
          "properties": {
            "type": {
              "const": "bindCompleted"
            },
            "jobId": {
              "$ref": "#/$defs/JobId",
              "description": "The beginBind job."
            },
            "ownerId": {
              "$ref": "../../../_shared/0.1/git-ns.schema.json#/$defs/ForgeId",
              "description": "The forge's id for the owner, which survives renames."
            },
            "kind": {
              "type": "string",
              "enum": [
                "organization",
                "user"
              ]
            }
          }
        }
      ]
    },
    "Response": {
      "$anchor": "response",
      "title": "Git Namespaces — Bridge Event — response payload",
      "description": "The VTC has recorded the event. Nothing else is returned.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "ext": {
          "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
