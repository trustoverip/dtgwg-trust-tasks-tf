{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtn/directory/search/0.1",
  "title": "VTN Directory — Search — payload",
  "description": "A search of the network's published set. Every member is optional: an empty payload returns the whole published set. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "q": {
      "$ref": "../../../_shared/0.1/directory.schema.json#/$defs/SearchText"
    },
    "kind": {
      "$ref": "../../../_shared/0.1/entry.schema.json#/$defs/EntryKind",
      "description": "Only entries of this kind."
    },
    "state": {
      "$ref": "../../../_shared/0.1/entry.schema.json#/$defs/EntryState",
      "description": "Only entries in this state."
    },
    "membersOnly": {
      "$ref": "../../../_shared/0.1/directory.schema.json#/$defs/MembersOnly"
    },
    "membership": {
      "$ref": "../../../_shared/0.1/entry.schema.json#/$defs/Membership",
      "description": "A person's membership credential from a member community, holder-bound to the signer; admits the person to a `members` directory."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTN Directory — Search — response payload",
      "description": "The matching published entries, members first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "../../../_shared/0.1/directory.schema.json#/$defs/DirectoryEntry"
          },
          "description": "The results, each stating its own state and whether it is a member."
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
