{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtn/_shared/0.1/rooms.schema.json",
  "title": "VTN — Rooms",
  "description": "Network rooms: a room belongs to a role, and a person reaches it through their community's registered group for that role.",
  "$defs": {
    "RoomDef": {
      "description": "A room.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "passMinutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "The room's id."
        },
        "name": {
          "type": "string",
          "maxLength": 200,
          "description": "Its name."
        },
        "role": {
          "$ref": "groups.schema.json#/$defs/RoleName",
          "description": "The role whose groups' members may enter."
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "What it is for."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "description": "Where the room is."
        },
        "passMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "description": "How long a pass lasts, in minutes: at most 1440 (24 hours). A pass is short-lived because it is not revoked; eligibility is re-proved for the next one."
        }
      }
    },
    "RoomPass": {
      "description": "A room pass.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "room",
        "pass",
        "via"
      ],
      "properties": {
        "room": {
          "$ref": "#/$defs/RoomDef"
        },
        "pass": {
          "$ref": "entry.schema.json#/$defs/Credential",
          "description": "The pass: a credential the network signs for the person, valid for `passMinutes`."
        },
        "via": {
          "type": "array",
          "items": {
            "$ref": "entry.schema.json#/$defs/Did"
          },
          "description": "The networks the person's eligibility ran through, from the one nearest their community up to this network."
        }
      }
    }
  }
}
