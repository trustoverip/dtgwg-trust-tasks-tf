{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/vtn/graph/show/0.1",
  "title": "VTN Graph — Show — payload",
  "description": "A request for the network's trust graph. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {
    "includeExited": {
      "type": "boolean",
      "description": "Also show removed and departed entries. For administrators only; absent means false."
    },
    "membership": {
      "$ref": "../../../_shared/0.1/entry.schema.json#/$defs/Membership",
      "description": "A person's membership credential from a member community, holder-bound to the signer; admits the person to a `members` directory."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "VTN Graph — Show — response payload",
      "description": "The network's trust graph.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph"
      ],
      "properties": {
        "graph": {
          "$ref": "../../../_shared/0.1/graph.schema.json#/$defs/Graph"
        },
        "ext": {
          "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext"
        }
      }
    }
  }
}
