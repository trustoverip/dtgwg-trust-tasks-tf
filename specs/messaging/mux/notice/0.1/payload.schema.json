{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/messaging/mux/notice/0.1",
  "title": "Messaging — Mux Notice — payload",
  "description": "A durable notice from a mediator, stored in the recipient's inbox and delivered at least once, about grants the recipient must act on or know of: suspended, revoked, expiring, or present on a member DID. The members present depend on `notice`; see the specification. The outer document members are owned by the framework — SPEC §6.3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "notice"
  ],
  "properties": {
    "notice": {
      "type": "string",
      "enum": [
        "grantsSuspended",
        "grantsRevoked",
        "grantsExpiring",
        "grantsPresent"
      ],
      "description": "Which notice this is. Each kind carries the members the specification lists for it, and no others."
    },
    "suspensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "title": "Suspension",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "did",
          "grantIds",
          "reason",
          "suspendedAt"
        ],
        "properties": {
          "did": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/MuxDid",
            "description": "The member DID."
          },
          "grantIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "../../_shared/0.1/mux.schema.json#/$defs/GrantId"
            }
          },
          "reason": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/DetachReason",
            "description": "Why: `suspendedUnknownKey` in this version."
          },
          "suspendedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the suspension was committed."
          }
        }
      },
      "description": "`grantsSuspended` only, REQUIRED: the recipient's grants that were suspended. They must be recreated by a fresh messaging/mux/grant signed by the member DID under its current epoch."
    },
    "revocations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "title": "Revocation",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "did",
          "grantIds",
          "reason",
          "revokedAt"
        ],
        "properties": {
          "did": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/MuxDid",
            "description": "The member DID."
          },
          "grantIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "$ref": "../../_shared/0.1/mux.schema.json#/$defs/GrantId"
            }
          },
          "reason": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/DetachReason",
            "description": "Why: `revokedByMember`, `epochBumped`, `admin` or `accountRemoved`."
          },
          "revokedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the revocation was committed."
          }
        }
      },
      "description": "`grantsRevoked` only, REQUIRED: the recipient's grants that were revoked by someone other than the recipient."
    },
    "expiring": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "title": "ExpiringGrant",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grantId",
          "did",
          "expiresAt"
        ],
        "properties": {
          "grantId": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/GrantId"
          },
          "did": {
            "$ref": "../../_shared/0.1/mux.schema.json#/$defs/MuxDid",
            "description": "The member DID."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "The grant's effective expiry."
          }
        }
      },
      "description": "`grantsExpiring` only, REQUIRED: grants delegated to the recipient that have passed about three quarters of their lifetime."
    },
    "did": {
      "$ref": "../../_shared/0.1/mux.schema.json#/$defs/MuxDid",
      "description": "`grantsPresent` only, REQUIRED: the member DID the recipient authenticated as."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "`grantsPresent` only, REQUIRED: grants on the member DID the mediator holds, in every state."
    },
    "suspended": {
      "type": "integer",
      "minimum": 0,
      "description": "`grantsPresent` only, REQUIRED: how many of them this authentication just suspended under the unknown-key rule."
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "description": "`grantsPresent` only, REQUIRED: the member DID's epoch now in force."
    },
    "ext": {
      "$ref": "../../../../_framework/0.4/framework.schema.json#/$defs/Ext",
      "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
    }
  }
}
