{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/messaging/account/remove/0.1",
  "title": "Messaging Remove Account — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["did"],
  "properties": {
    "did": {
      "$ref": "../../../_shared/0.1/messaging.schema.json#/$defs/Vid",
      "description": "The DID of the account to remove."
    },
    "ext": {
      "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
      "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Messaging Remove Account — response payload",
      "description": "The success response to a messaging/account/remove request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/messaging/account/remove/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["did", "removed"],
      "properties": {
        "did": {
          "$ref": "../../../_shared/0.1/messaging.schema.json#/$defs/Vid",
          "description": "The account that was removed."
        },
        "removed": {
          "type": "boolean",
          "description": "Whether the account was removed."
        },
        "ext": {
          "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
          "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
        }
      }
    }
  }
}
