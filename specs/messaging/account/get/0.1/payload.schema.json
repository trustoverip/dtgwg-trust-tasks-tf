{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/messaging/account/get/0.1",
  "title": "Messaging Get Account — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["did"],
  "properties": {
    "did": {
      "$ref": "../../../_shared/0.1/messaging.schema.json#/$defs/Vid",
      "description": "The DID of the account to fetch."
    },
    "ext": {
      "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
      "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Messaging Get Account — response payload",
      "description": "The success response to a messaging/account/get request. Carried in a Trust Task document whose type is https://trusttasks.org/spec/messaging/account/get/0.1#response.",
      "type": "object",
      "additionalProperties": false,
      "required": ["account"],
      "properties": {
        "account": {
          "$ref": "../../../_shared/0.1/messaging.schema.json#/$defs/Account",
          "description": "The full mediator view of the requested account."
        },
        "ext": {
          "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
          "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
        }
      }
    }
  }
}
