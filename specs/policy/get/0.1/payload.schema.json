{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/policy/get/0.1",
  "title": "Policy Get — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["id"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "The id of the policy module to fetch."
    },
    "ext": { "$ref": "../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Policy Get — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": { "$ref": "../../_shared/0.3/policy.schema.json#/$defs/PolicyModule" },
        "ext": { "$ref": "../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
