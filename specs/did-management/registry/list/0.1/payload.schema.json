{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/did-management/registry/list/0.1",
  "title": "Registry List — payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "serviceType": {
      "type": "string",
      "enum": ["server", "witness", "watcher"],
      "description": "Only instances of this type. Absent means every type."
    },
    "status": {
      "type": "string",
      "enum": ["active", "degraded", "unreachable"],
      "description": "Only instances with this health verdict. Absent means every verdict."
    },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Registry List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["instances"],
      "properties": {
        "instances": {
          "type": "array",
          "items": { "$ref": "../../../_shared/0.2/service-instance.schema.json#/$defs/ServiceInstance" },
          "description": "Every matching instance, ordered by `instanceId`. Empty when none matches."
        },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
