{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/did-management/server/register/0.1",
  "title": "Server Register — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["instanceId", "did", "publicUrl", "servedDomains"],
  "properties": {
    "instanceId": { "type": "string", "minLength": 1 },
    "did": { "type": "string", "minLength": 1 },
    "publicUrl": { "type": "string", "format": "uri" },
    "servedDomains": { "type": "array", "items": { "type": "string" } },
    "label": { "type": "string" },
    "enabledMethods": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "DID methods the server is willing to host (e.g. ['webvh', 'web']). Omit to default to ['webvh']."
    },
    "protocolVersion": {
      "type": "string",
      "minLength": 1,
      "description": "Wire-protocol revision the server speaks (e.g. '1.0'). Omit to default to '1.0'."
    },
    "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Server Register — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "accepted", "lastSeen"],
      "properties": {
        "instanceId": { "type": "string" },
        "accepted": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
