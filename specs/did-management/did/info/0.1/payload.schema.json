{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/did-management/did/info/0.1",
  "title": "DID Management Info — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["mnemonic"],
  "properties": {
    "mnemonic": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "description": "Optional explicit hosting domain. See [category conventions §1](../../../_shared/0.1/CONVENTIONS.md#1-domain-resolution). Unknown domains return `did-management:unknown_domain`."
    },
    "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "DID Management Info — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["record"],
      "properties": {
        "record": { "$ref": "../../../_shared/0.1/did-record.schema.json#/$defs/DidRecord" },
        "logSummary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latestVersionId": { "type": "string" },
            "latestVersionTime": { "type": "string", "format": "date-time" }
          }
        },
        "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
