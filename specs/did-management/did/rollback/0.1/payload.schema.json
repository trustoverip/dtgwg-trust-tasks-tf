{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/did-management/did/rollback/0.1",
  "title": "DID Management Rollback — payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["mnemonic", "targetVersion"],
  "properties": {
    "mnemonic": { "type": "string", "minLength": 1 },
    "targetVersion": { "type": "integer", "minimum": 1 },
    "domain": { "type": "string" },
    "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "DID Management Rollback — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["record", "removedVersions"],
      "properties": {
        "record": { "$ref": "../../../_shared/0.1/did-record.schema.json#/$defs/DidRecord" },
        "removedVersions": { "type": "integer", "minimum": 0 },
        "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
