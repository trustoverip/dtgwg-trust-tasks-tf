{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/did-management/domain/list/0.1",
  "title": "Domain List — payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "type": "string",
      "enum": ["active", "disabled"],
      "description": "Only domains in this state. Absent means every state."
    },
    "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Domain List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["domains"],
      "properties": {
        "domains": {
          "type": "array",
          "items": { "$ref": "../../../_shared/0.1/domain-entry.schema.json#/$defs/DomainEntry" },
          "description": "Every matching hosting domain, ordered by name."
        },
        "default": {
          "type": "string",
          "description": "The service's system-default domain. Absent when none is set."
        },
        "ext": { "$ref": "../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
