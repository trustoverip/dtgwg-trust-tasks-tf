{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/auth/passkey/enroll/redeem/finish/0.1",
  "title": "Auth — Passkey Enroll (redeem, finish)",
  "description": "The invitee returns the attestation — and, where the subject already has a credential of the same purpose, a user-verified assertion from it — and the auth service binds the new credential to the invite's subject and consumes the invite.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enrollmentId",
    "credential"
  ],
  "properties": {
    "enrollmentId": {
      "type": "string",
      "minLength": 1,
      "description": "The enrollmentId from auth/passkey/enroll/redeem/start. Echoed verbatim."
    },
    "credential": {
      "$ref": "../../../../../_shared/0.1/webauthn.schema.json#/$defs/AttestationResponse",
      "description": "AuthenticatorAttestationResponse as returned by navigator.credentials.create."
    },
    "uvCredential": {
      "$ref": "../../../../../_shared/0.1/webauthn.schema.json#/$defs/AssertionResponse",
      "description": "AuthenticatorAssertionResponse over the start's uvOptions. REQUIRED exactly when start returned uvOptions."
    },
    "deviceLabel": {
      "type": "string",
      "maxLength": 256,
      "description": "Label for the credential. Overrides the inviter's suggestion."
    },
    "ext": {
      "$ref": "../../../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
      "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
    }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Auth Passkey Enroll Redeem Finish — response payload",
      "description": "The registered credential.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credentialId",
        "subject",
        "purpose",
        "registeredAt"
      ],
      "properties": {
        "credentialId": {
          "type": "string",
          "minLength": 1,
          "description": "base64url-encoded WebAuthn credential id."
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "description": "The VID the credential is now bound to."
        },
        "purpose": {
          "type": "string",
          "enum": [
            "session",
            "stepUp"
          ],
          "description": "What the credential authenticates."
        },
        "deviceLabel": {
          "type": "string",
          "maxLength": 256,
          "description": "The label persisted with the credential."
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        },
        "ext": {
          "$ref": "../../../../../../_framework/0.2/framework.schema.json#/$defs/Ext",
          "description": "Ecosystem-defined extension members per SPEC.md §4.5.1."
        }
      }
    }
  }
}
