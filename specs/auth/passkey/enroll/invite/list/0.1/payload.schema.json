{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/auth/passkey/enroll/invite/list/0.1",
  "title": "Auth Passkey Invite List — payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "includeExpired": {
      "type": "boolean",
      "description": "When true, invites whose expiry has passed are listed too. Absent or false means only unexpired invites are listed."
    },
    "ext": { "$ref": "../../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Auth Passkey Invite List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["invites"],
      "properties": {
        "invites": {
          "type": "array",
          "items": { "$ref": "../../../../../_shared/0.1/passkey-invite.schema.json#/$defs/InviteSummary" },
          "description": "Every unredeemed invite within the administrator's authority, newest first."
        },
        "ext": { "$ref": "../../../../../../_framework/0.2/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
