    "action": { "type": "string" },
    "resource": { "type": "string" },
    "ext": { "$ref": "../../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Registry Record Delete — response payload",
      "type": "object",
