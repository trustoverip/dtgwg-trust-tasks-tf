{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trusttasks.org/spec/device/list/0.1",
  "title": "Device List — payload",
  "description": "List DeviceBindings known to the maintainer, optionally filtered by consumer kind, capability, status, and last-seen time.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "consumerKindFilter": {
      "type": "string",
      "enum": ["companion", "service"]
    },
    "formFactorFilter": {
      "type": "string",
      "enum": ["browser", "mobile", "desktop"]
    },
    "serviceKindFilter": {
      "type": "string",
      "enum": ["mediator", "ai-agent", "daemon"]
    },
    "capabilityFilter": {
      "$ref": "../../_shared/0.1/device-binding.schema.json#/$defs/Capability"
    },
    "includeDisabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, include devices with `disabledAt` set. Default omits disabled."
    },
    "includeWiped": {
      "type": "boolean",
      "default": false
    },
    "lastSeenSince": { "type": "string", "format": "date-time" },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "cursor": { "type": "string" },
    "ext": { "$ref": "../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
  },
  "$defs": {
    "Response": {
      "$anchor": "response",
      "title": "Device List — response payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["devices", "truncated"],
      "properties": {
        "devices": {
          "type": "array",
          "items": { "$ref": "../../_shared/0.1/device-binding.schema.json#/$defs/DeviceBinding" }
        },
        "truncated": { "type": "boolean" },
        "cursor": { "type": "string" },
        "ext": { "$ref": "../../../_framework/0.1/framework.schema.json#/$defs/Ext" }
      }
    }
  }
}
