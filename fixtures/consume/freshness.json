{
  "description": "The acceptance window of SPEC §7.2 (items 4 and 13, *Bounding the record*) as every runtime applies it. Each case builds a document carrying the case's `issuedAt` and `expiresAt` (absent where the case omits them), runs the expiry check of item 4 (validate_basic / validateBasic / ValidateBasic, with no recipient) and then the freshness check (validate_freshness / validateFreshness / ValidateFreshness) at `now` under the named policy, and must reach `verdict`: `accept`, or the code the first failing check refuses with (`expired` or `malformedRequest`). A timestamp the runtime cannot read at all is `malformedRequest`. For an accepted case, the record expiry (record_expiry / recordExpiry / RecordExpiry) at `now` must equal `recordExpiry`, or be unbounded where it is null. Policies are in milliseconds; a member that is absent is unset (no maximum age, no expiry horizon), and `requireIssuedAt` defaults to false. `default` and `consequential` must equal each runtime's own default and consequential policy constants.",
  "policies": {
    "default": {
      "skewMs": 60000,
      "requireIssuedAt": false
    },
    "consequential": {
      "skewMs": 60000,
      "maxAgeMs": 300000,
      "expiryHorizonMs": 2592000000,
      "requireIssuedAt": true
    },
    "maxAgeOnly": {
      "skewMs": 60000,
      "maxAgeMs": 300000,
      "requireIssuedAt": false
    },
    "windowNoRequirement": {
      "skewMs": 60000,
      "maxAgeMs": 300000,
      "expiryHorizonMs": 2592000000,
      "requireIssuedAt": false
    },
    "zeroHorizon": {
      "skewMs": 60000,
      "maxAgeMs": 300000,
      "expiryHorizonMs": 0,
      "requireIssuedAt": true
    },
    "noSkew": {
      "skewMs": 0,
      "maxAgeMs": 300000,
      "expiryHorizonMs": 2592000000,
      "requireIssuedAt": true
    }
  },
